#!/usr/bin/env bash
# Copy the tracked config/scripts/apps into this repo, then commit and push.
# Usage: dotfiles-sync "short message describing what changed"
set -uo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"   # follow the ~/.local/bin link back to the repo
MSG="${1:-update dotfiles}"
cd "$REPO" || exit 1

# --- Hyprland (config + scripts), excluding backups ---
rsync -a --delete --exclude='*.bak*' --exclude='Crash Reports/' "$HOME/.config/hypr/" "home/.config/hypr/"
# --- Noctalia shell config + its saved settings ---
rsync -a --delete "$HOME/.config/noctalia/" "home/.config/noctalia/" 2>/dev/null
cp -a "$HOME/.local/state/noctalia/settings.toml" "home/.local/state/noctalia/" 2>/dev/null

# --- Island shell (Quickshell config) + its saved settings ---
mkdir -p home/.config/quickshell home/.local/state/island
rsync -a --delete --exclude='*.bak*' --exclude='__pycache__/' "$HOME/.config/quickshell/island/" "home/.config/quickshell/island/"
cp -a "$HOME/.local/state/island/prefs.json" "home/.local/state/island/" 2>/dev/null

# --- Island login screen (greeter) sources; install with: sudo ~/.config/quickshell/island-greeter/install.sh ---
rsync -a --delete "$HOME/.config/quickshell/island-greeter/" "home/.config/quickshell/island-greeter/"

# --- Island look for Qt/KDE apps: Kvantum theme, candy icons, colour scheme, qt6ct, fonts, default wallpaper ---
mkdir -p home/.config/Kvantum home/.local/share/icons home/.local/share/color-schemes home/.config/qt6ct/colors home/.local/share/fonts home/Pictures/Wallpapers
rsync -a --delete --exclude='*.bak*' "$HOME/.config/Kvantum/" "home/.config/Kvantum/"
rsync -a --delete "$HOME/.local/share/icons/Island/" "home/.local/share/icons/Island/"
cp -a "$HOME/.local/share/color-schemes/Island.colors" "$HOME/.local/share/color-schemes/IslandDark.colors" "home/.local/share/color-schemes/" 2>/dev/null
# GTK apps (keyring prompt, file pickers, dialogs) in Island colours
for v in 3.0 4.0; do mkdir -p home/.config/gtk-$v && cp -a "$HOME/.config/gtk-$v/gtk.css" "$HOME/.config/gtk-$v/"island*.css home/.config/gtk-$v/ 2>/dev/null; [ -f "$HOME/.config/gtk-$v/settings.ini" ] && cp -a "$HOME/.config/gtk-$v/settings.ini" home/.config/gtk-$v/; done
# handoff notes for the next person / AI
python3 "$HOME/.config/quickshell/island/tools/wishlist-sync.py" 2>/dev/null   # handoff §8b ← "Rice wish list" board
mkdir -p docs && cp -a "$HOME/Documents/Md_File/RICE-HANDOFF.md" docs/ 2>/dev/null
# Dolphin look (icon view, previews, panels, Island Dark colours)
cp -a "$HOME/.config/dolphinrc" "home/.config/" 2>/dev/null
cp -a "$HOME/.config/xdg-terminals.list" "home/.config/" 2>/dev/null   # terminal for Terminal=true apps (uwsm)
mkdir -p home/.config/uwsm && cp -a "$HOME/.config/uwsm/env" home/.config/uwsm/   # session env: fcitx, browser, GPU pick (scripts/gpu-pick.sh)
mkdir -p home/.config/kitty && rsync -a --delete --exclude='*.bak*' "$HOME/.config/kitty/" "home/.config/kitty/"   # kitty (opacity set from Island → Windows)
mkdir -p home/.local/share/dolphin/view_properties/global && cp -a "$HOME/.local/share/dolphin/view_properties/global/.directory" "home/.local/share/dolphin/view_properties/global/" 2>/dev/null
cp -a "$HOME/.config/qt6ct/qt6ct.conf" "home/.config/qt6ct/" 2>/dev/null
cp -a "$HOME/.config/qt6ct/colors/island.conf" "home/.config/qt6ct/colors/" 2>/dev/null
cp -a "$HOME/.config/kdeglobals" "home/.config/" 2>/dev/null
rsync -a --delete "$HOME/.local/share/fonts/island/" "home/.local/share/fonts/island/"
cp -a "$HOME/Pictures/Wallpapers/island-default.png" "home/Pictures/Wallpapers/" 2>/dev/null

# --- PipeWire: "Laptop Mic (clear)" voice filter ---
mkdir -p home/.config/pipewire/pipewire.conf.d
rsync -a --delete "$HOME/.config/pipewire/pipewire.conf.d/" "home/.config/pipewire/pipewire.conf.d/"

# --- XDG autostart overrides: fcitx5's system entry hidden (autostart.lua starts it; two copies broke Ctrl+Shift) ---
mkdir -p home/.config/autostart
rsync -a --delete "$HOME/.config/autostart/" "home/.config/autostart/"

# --- fcitx5: EN/VI toggle = Ctrl+Alt+Shift (Ctrl+Shift fired by accident in games), bamboo profile ---
mkdir -p home/.config/fcitx5 && cp -a "$HOME/.config/fcitx5/config" "$HOME/.config/fcitx5/profile" home/.config/fcitx5/

# --- user D-Bus service override: keyring starts via systemd (no second gnome-keyring-daemon) ---
mkdir -p home/.local/share/dbus-1/services
cp -a "$HOME/.local/share/dbus-1/services/org.freedesktop.secrets.service" home/.local/share/dbus-1/services/ 2>/dev/null

# --- custom systemd user units ---
for u in screentime-archive.service screentime-archive.timer island-greeter-sync.path island-greeter-sync.service \
         godot-vulkan-fix.service godot-vulkan-fix.timer godot-vulkan-fix.path; do
    [ -f "$HOME/.config/systemd/user/$u" ] && cp -a "$HOME/.config/systemd/user/$u" "home/.config/systemd/user/"
done

# --- custom app launchers ---
for d in file-sharing-toggle; do
    [ -f "$HOME/.local/share/applications/$d.desktop" ] && \
        cp -a "$HOME/.local/share/applications/$d.desktop" "home/.local/share/applications/"
done

# --- package lists (so a reinstall can put every app back) ---
pacman -Qqen > packages-native.txt
pacman -Qqem > packages-aur.txt

# --- default apps (pictures → qView, browser → Helium, …) + qView's fit settings (not its recent-files list) ---
cp -a "$HOME/.config/mimeapps.list" home/.config/
mkdir -p home/.config/qView && awk '/^\[/{p=($0=="[options]")} p' "$HOME/.config/qView/qView.conf" > home/.config/qView/qView.conf

# --- GRUB theme package (Evangelion, chosen with `sudo eva`); install.sh puts it back and re-selects Soryu 1440p ---
mkdir -p system/usr/local/share && rsync -a --delete /usr/local/share/evangelion/ system/usr/local/share/evangelion/

# --- also publish Island to its own repo (github.com/minhtriet199/Cachy-OS-Hyprland-Island) ---
[ -x "$HOME/island-repo/island-sync" ] && "$HOME/island-repo/island-sync" "$MSG"

# --- Island login screen: say so when its installed copy is older than your Island files ---
if [ -d /usr/local/share/island-greeter ]; then
    t=$(mktemp -d)
    if sh "$HOME/.config/quickshell/island-greeter/build.sh" "$t" >/dev/null 2>&1 && ! diff -rq "$t" /usr/local/share/island-greeter >/dev/null 2>&1; then
        echo "NOTE: the Island login screen is out of date → sudo ~/.config/quickshell/island-greeter/install.sh, then check.sh"
    fi
    rm -rf "$t"
fi

git add -A
if git diff --cached --quiet; then
    echo "Nothing changed."
    exit 0
fi
git commit -m "$MSG" || exit 1
if git push 2>/dev/null || git push -u origin HEAD 2>/dev/null; then
    echo "Pushed: $MSG"
else
    echo "Committed locally, but push failed. Run 'gh auth login' once, then: cd ~/dotfiles && git push -u origin main"
fi
