#!/usr/bin/env bash
# Copy the tracked config/scripts/apps into this repo, then commit and push.
# Usage: dotfiles-sync "short message describing what changed"
set -uo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"   # follow the ~/.local/bin link back to the repo
MSG="${1:-update dotfiles}"
cd "$REPO" || exit 1

# --- Hyprland (config + scripts), excluding backups ---
rsync -a --delete --exclude='*.bak*' --exclude='Crash Reports/' "$HOME/.config/hypr/" "home/.config/hypr/"
# --- Noctalia shell config + its saved settings ---
rsync -a --delete "$HOME/.config/noctalia/" "home/.config/noctalia/" 2>/dev/null
cp -a "$HOME/.local/state/noctalia/settings.toml" "home/.local/state/noctalia/" 2>/dev/null

# --- Isla shell (Quickshell config) + its saved settings ---
mkdir -p home/.config/quickshell home/.local/state/isla
rsync -a --delete --exclude='*.bak*' --exclude='__pycache__/' "$HOME/.config/quickshell/isla/" "home/.config/quickshell/isla/"
cp -a "$HOME/.local/state/isla/prefs.json" "home/.local/state/isla/" 2>/dev/null

# --- Isla login screen (greeter) sources; install with: sudo ~/.config/quickshell/isla-greeter/install.sh ---
rsync -a --delete "$HOME/.config/quickshell/isla-greeter/" "home/.config/quickshell/isla-greeter/"

# --- Isla look for Qt/KDE apps: Kvantum theme, candy icons, colour scheme, qt6ct, fonts, default wallpaper ---
mkdir -p home/.config/Kvantum home/.local/share/icons home/.local/share/color-schemes home/.config/qt6ct/colors home/.local/share/fonts home/Pictures/Wallpapers
rsync -a --delete --exclude='*.bak*' "$HOME/.config/Kvantum/" "home/.config/Kvantum/"
rsync -a --delete "$HOME/.local/share/icons/Isla/" "home/.local/share/icons/Isla/"
cp -a "$HOME/.local/share/color-schemes/Isla.colors" "$HOME/.local/share/color-schemes/IslaDark.colors" "home/.local/share/color-schemes/" 2>/dev/null
# GTK apps (keyring prompt, file pickers, dialogs) in Isla colours
for v in 3.0 4.0; do mkdir -p home/.config/gtk-$v && cp -a "$HOME/.config/gtk-$v/gtk.css" "$HOME/.config/gtk-$v/"isla*.css home/.config/gtk-$v/ 2>/dev/null; [ -f "$HOME/.config/gtk-$v/settings.ini" ] && cp -a "$HOME/.config/gtk-$v/settings.ini" home/.config/gtk-$v/; done
# handoff notes for the next person / AI
mkdir -p docs && cp -a "$HOME/Documents/Md_File/RICE-HANDOFF.md" docs/ 2>/dev/null
# Dolphin look (icon view, previews, panels, Isla Dark colours)
cp -a "$HOME/.config/dolphinrc" "home/.config/" 2>/dev/null
cp -a "$HOME/.config/xdg-terminals.list" "home/.config/" 2>/dev/null   # terminal for Terminal=true apps (uwsm)
mkdir -p home/.config/kitty && rsync -a --delete --exclude='*.bak*' "$HOME/.config/kitty/" "home/.config/kitty/"   # kitty (opacity set from Isla → Windows)
mkdir -p home/.local/share/dolphin/view_properties/global && cp -a "$HOME/.local/share/dolphin/view_properties/global/.directory" "home/.local/share/dolphin/view_properties/global/" 2>/dev/null
cp -a "$HOME/.config/qt6ct/qt6ct.conf" "home/.config/qt6ct/" 2>/dev/null
cp -a "$HOME/.config/qt6ct/colors/isla.conf" "home/.config/qt6ct/colors/" 2>/dev/null
cp -a "$HOME/.config/kdeglobals" "home/.config/" 2>/dev/null
rsync -a --delete "$HOME/.local/share/fonts/isla/" "home/.local/share/fonts/isla/"
cp -a "$HOME/Pictures/Wallpapers/isla-default.png" "home/Pictures/Wallpapers/" 2>/dev/null

# --- PipeWire: "Laptop Mic (clear)" voice filter ---
mkdir -p home/.config/pipewire/pipewire.conf.d
rsync -a --delete "$HOME/.config/pipewire/pipewire.conf.d/" "home/.config/pipewire/pipewire.conf.d/"

# --- user D-Bus service override: keyring starts via systemd (no second gnome-keyring-daemon) ---
mkdir -p home/.local/share/dbus-1/services
cp -a "$HOME/.local/share/dbus-1/services/org.freedesktop.secrets.service" home/.local/share/dbus-1/services/ 2>/dev/null

# --- custom systemd user units ---
for u in screentime-archive.service screentime-archive.timer isla-greeter-sync.path isla-greeter-sync.service \
         godot-vulkan-fix.service godot-vulkan-fix.timer godot-vulkan-fix.path; do
    [ -f "$HOME/.config/systemd/user/$u" ] && cp -a "$HOME/.config/systemd/user/$u" "home/.config/systemd/user/"
done

# --- custom app launchers ---
for d in file-sharing-toggle; do
    [ -f "$HOME/.local/share/applications/$d.desktop" ] && \
        cp -a "$HOME/.local/share/applications/$d.desktop" "home/.local/share/applications/"
done

# --- package lists (so a reinstall can put every app back) ---
pacman -Qqen > packages-native.txt
pacman -Qqem > packages-aur.txt

# --- also publish Isla to its own repo (github.com/minhtriet199/Cachy-OS-Hyprland-Island) ---
[ -x "$HOME/isla-island/isla-sync" ] && "$HOME/isla-island/isla-sync" "$MSG"

# --- Isla login screen: say so when its installed copy is older than your Isla files ---
if [ -d /usr/local/share/isla-greeter ]; then
    t=$(mktemp -d)
    if sh "$HOME/.config/quickshell/isla-greeter/build.sh" "$t" >/dev/null 2>&1 && ! diff -rq "$t" /usr/local/share/isla-greeter >/dev/null 2>&1; then
        echo "NOTE: the Isla login screen is out of date → sudo ~/.config/quickshell/isla-greeter/install.sh, then check.sh"
    fi
    rm -rf "$t"
fi

git add -A
if git diff --cached --quiet; then
    echo "Nothing changed."
    exit 0
fi
git commit -m "$MSG" || exit 1
if git push 2>/dev/null || git push -u origin HEAD 2>/dev/null; then
    echo "Pushed: $MSG"
else
    echo "Committed locally, but push failed. Run 'gh auth login' once, then: cd ~/dotfiles && git push -u origin main"
fi
