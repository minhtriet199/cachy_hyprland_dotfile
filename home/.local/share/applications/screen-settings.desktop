[Desktop Entry]
Type=Application
Name=Screen Settings
Comment=Brightness, HDR, resolution, refresh rate and scale for every screen
Exec=/home/gamer/.config/hypr/scripts/hdr.sh set
Icon=preferences-desktop-display
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=hdr;asus;monitor;brightness;screen;display;resolution;refresh;scale;zoom;external;
StartupWMClass=dev.gamer.ScreenSettings
