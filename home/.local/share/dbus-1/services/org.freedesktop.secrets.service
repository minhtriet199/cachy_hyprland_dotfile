# Isla rice: start the keyring through its systemd unit (socket-activated) so a login-time request
# can't start a second, unused gnome-keyring-daemon next to it.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
SystemdService=gnome-keyring-daemon.service
