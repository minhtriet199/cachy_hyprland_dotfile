[%General]
author=Tsu Jan
comment=Isla — candy Animal Crossing style (based on KvFlatLight)
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=true
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=6
splitter_width=7
scroll_width=14
scroll_min_extent=60
scroll_arrows=false
transient_scrollbar=false
transient_groove=true
slider_width=4
slider_handle_width=22
slider_handle_length=18
tickless_slider_handle_size=18
center_toolbar_handle=true
toolbar_interior_spacing=2
check_size=16
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
animate_states=true
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=true
groupbox_top_label=false
inline_spin_indicators=true
joined_inactive_tabs=true
layout_spacing=3
scrollbar_in_view=false
submenu_overlap=3
tooltip_delay=-1

[GeneralColors]
window.color=#FFF4E0
base.color=#FFFDF6
alt.base.color=#FFF6E6
button.color=#FFF0D4
light.color=#FFFFFF
mid.light.color=#FFF9EC
dark.color=#C9B79A
mid.color=#E6D6B8
highlight.color=#A9DDE4
inactive.highlight.color=#C8E8EC
text.color=#33505B
window.text.color=#33505B
button.text.color=#33505B
disabled.text.color=#9AAFB6
tooltip.text.color=#33505B
highlight.text.color=#213F48
link.color=#2F9EAB
link.visited.color=#8E7BE6
progress.indicator.text.color=#213F48

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
blur_translucent=true
transparent_menutitle=false
respect_darkness=false
disabled_icon_opacity=100
force_size_grip=true
iconless_menu=false
iconless_pushbutton=false
lxqtmainmenu_iconsize=22
normal_default_pushbutton=false
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false
no_selection_tint=true
transparent_arrow_button=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=10
frame.bottom=13
frame.left=10
frame.right=10
interior=true
interior.element=button
indicator.size=10
text.normal.color=#33505B
text.focus.color=#33505B
text.press.color=#213F48
text.toggle.color=#213F48
text.shadow=0
text.margin=1
text.iconspacing=4
indicator.element=b-arrow
text.margin.top=3
text.margin.bottom=3
text.margin.left=3
text.margin.right=3
frame.expansion=8
min_width=+0.1font

[PanelButtonTool]
frame.right=10
frame.left=10
frame.bottom=13
frame.top=10
inherits=PanelButtonCommand

[ToolbarButton]
frame.right=10
frame.left=10
frame.bottom=13
frame.top=10
inherits=PanelButtonCommand
focusRectElement=tfocus

[ToolbarComboBox]
inherits=PanelButtonCommand
indicator.element=none
focusRectElement=tfocus

[ToolbarLineEdit]
frame.right=12
frame.left=12
frame.bottom=12
frame.top=12
interior.element=tlineedit
frame.element=tlineedit

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
indicator.element=btn
text.normal.color=#33505B

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#33505B
text.focus.color=#33505B
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=s-arrow
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
indicator.size=10

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.normal.color=#33505B
text.focus.color=#33505B

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.normal.color=#33505B
text.focus.color=#33505B

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[LineEdit]
frame.right=12
frame.left=12
frame.bottom=12
frame.top=12
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
indicator.element=flat-s-arrow-down
text.margin.left=2
text.margin.right=2

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=b-arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=10

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color=#33505B
text.press.color=#33505B
text.focus.color=#33505B

[Tab]
inherits=PanelButtonCommand
interior.element=tab
text.margin.left=3
text.margin.right=3
text.margin.top=1
text.margin.bottom=1
frame.element=tab
indicator.element=tab
indicator.size=12
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.normal.color=#33505B
text.focus.color=#33505B
text.toggle.color=#213F48
text.bold=true
text.shadow=true
text.shadow.color=white
text.shadow.alpha=210
text.shadow.xshift=1
text.shadow.yshift=1
text.shadow.depth=1
min_width=+0.3font
min_height=0
frame.expansion=0

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=10
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
interior.element=toolbar
frame.element=toolbar
frame.top=0
frame.bottom=4
frame.left=0
frame.right=0
text.normal.color=#33505B
text.focus.color=#33505B

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
indicator.element=none

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.normal.color=#33505B
text.focus.color=#33505B
text.press.color=#213F48
text.toggle.color=#213F48
text.bold=true
frame.expansion=2.8font

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=2.8font

[ItemView]
inherits=PanelButtonCommand
text.margin=true
frame.element=itemview
interior.element=itemview
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.margin.top=0
text.margin.bottom=0
text.margin.left=2
text.margin.right=2
text.normal.color=#33505B
text.focus.color=#33505B
text.press.color=#213F48
min_height=0

[Splitter]
inherits=PanelButtonCommand
interior.element=splitter
frame.element=splitter
frame.top=0
frame.bottom=0
frame.left=1
frame.right=1
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=12

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
indicator.element=grip
indicator.size=13
frame.expansion=0

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.normal.color=#33505B
text.focus.color=#33505B
text.margin.top=2
text.margin.bottom=2
text.margin.left=10
text.margin.right=3
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
frame.expansion=0
min_height=0

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior.element=menubar
text.normal.color=#33505B
frame.expansion=0

[MenuBarItem]
inherits=PanelButtonCommand
interior=false
frame.element=menubar
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=5
text.margin.right=5
text.normal.color=#33505B
text.focus.color=#33505B
frame.expansion=0
min_height=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
indicator.element=mdi
text.normal.color=#33505B
text.focus.color=#33505B
text.bold=true
text.italic=true
frame.expansion=0

[ComboBox]
inherits=PanelButtonCommand
indicator.element=none
text.margin.left=4
text.margin.right=4

[Menu]
inherits=PanelButtonCommand
frame.top=14
frame.bottom=18
frame.left=14
frame.right=14
frame.element=menu
interior.element=menu
text.normal.color=#33505B
frame.expansion=0

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
text.shadow=0
text.margin=0
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color=#33505B
text.press.color=#213F48
text.focus.color=#33505B
frame.expansion=0

[TabBarFrame]
inherits=GenericFrame
frame=true
frame.element=tabbarFrame
interior=false
frame.top=0
frame.bottom=2
frame.left=0
frame.right=0

[ToolTip]
inherits=GenericFrame
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
text.shadow=0
text.margin=0
interior.element=tooltip
frame.element=tooltip
frame.expansion=0

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
