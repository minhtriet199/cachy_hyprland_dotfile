#!/bin/sh
# greetd default_session: the Isla login screen in a small Hyprland.
# Safety net: if it can't start (or crashes without logging you in) you get greetd's text login (agreety) instead.
share="${ISLA_GREETER_SHARE:-/usr/local/share/isla-greeter}"
export ISLA_GREETER_SHARE="$share"
export ISLA_GREETER_DATA="${ISLA_GREETER_DATA:-/var/lib/isla-greeter}"
export HOME="$ISLA_GREETER_DATA/home"
[ -n "${XDG_RUNTIME_DIR:-}" ] && [ -w "$XDG_RUNTIME_DIR" ] || export XDG_RUNTIME_DIR="/tmp/isla-greeter-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
rm -f "$XDG_RUNTIME_DIR/isla-greeter-ok"
unset WAYLAND_DISPLAY DISPLAY
log="$HOME/greeter.log"
mv -f "$log" "$log.old" 2>/dev/null

if command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- Hyprland -c "$share/greeter.lua" >"$log" 2>&1
else
    Hyprland -c "$share/greeter.lua" >"$log" 2>&1
fi

[ -e "$XDG_RUNTIME_DIR/isla-greeter-ok" ] && exit 0
echo "Isla login screen did not start (log: $log). Text login:"
exec agreety --cmd "uwsm start -e -D Hyprland hyprland.desktop"
