#!/bin/sh
# Copy what the login screen shows (Island look, lock wallpaper, your name, screen layout) into the
# greeter's data folder — the greeter user can't read your home. Run by island-greeter-sync.path on changes.
data="${ISLAND_GREETER_DATA:-/var/lib/island-greeter}"
[ -w "$data" ] || { echo "island-greeter-sync: $data is not writable (run the installer first)" >&2; exit 1; }
prefs="$HOME/.local/state/island/prefs.json"
[ -f "$prefs" ] && cp "$prefs" "$data/prefs.json"
[ -f "$HOME/.local/state/hypr/screens" ] && cp "$HOME/.local/state/hypr/screens" "$data/screens"
wall=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("lockWallpaper",""))' "$prefs" 2>/dev/null)
if [ -n "$wall" ] && [ -f "$wall" ]; then cp "$wall" "$data/lock-wallpaper"; else rm -f "$data/lock-wallpaper"; fi
pbg=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("phoneBg",""))' "$prefs" 2>/dev/null)
case "$pbg" in /*) [ -f "$pbg" ] && cp "$pbg" "$data/phone-bg" ;; *) rm -f "$data/phone-bg" ;; esac
[ -f "$HOME/.local/state/hypr/cover" ] && cp "$HOME/.local/state/hypr/cover" "$data/cover"
# you first, then the other people who can log in (uid 1000+, a real shell) for the phone's user pick
python3 -I - "$USER" > "$data/user.json" <<'PY'
import json, pwd, sys
me = sys.argv[1]
def item(p): return {"user": p.pw_name, "full": p.pw_gecos.split(",")[0]}
users = [p for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and not p.pw_shell.endswith(("nologin", "false"))]
users.sort(key=lambda p: (p.pw_name != me, p.pw_uid))
mine = next((item(p) for p in users if p.pw_name == me), {"user": me, "full": ""})
print(json.dumps({**mine, "users": [item(p) for p in users]}))
PY
chmod 644 "$data"/prefs.json "$data"/screens "$data"/user.json "$data"/lock-wallpaper "$data"/phone-bg "$data"/cover 2>/dev/null
exit 0
